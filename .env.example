# =============================================
# WasiatHub — Environment Variables Template
# Copy this file to .env.local and fill in values
# This file is safe to commit — contains NO real keys
# =============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Supabase Auth Hook — set this to a random secret, then register the hook URL in
# Supabase Dashboard → Authentication → Hooks → Send email
# Hook URL: https://wasiathub.my/api/auth/send-email
SUPABASE_AUTH_HOOK_SECRET=

# Billplz
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=
BILLPLZ_BASE_URL=https://www.billplz.com/api/v3

# App
NEXT_PUBLIC_APP_URL=
NEXTAUTH_SECRET=
NODE_ENV=
